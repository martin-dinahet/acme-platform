PORT=3000

# Comma-separated browser origins allowed to call the API (CORS + CSRF check).
WEB_ORIGINS="http://localhost:5173"

# --- @acme/backend-auth ---

# Points at the "auth_service" database on the shared local Postgres container.
AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the browser uses. This is the backend.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated browser origins allowed to call auth.
TRUSTED_ORIGINS="http://localhost:5173"

# --- @acme/backend-todos ---

# Points at the "todos_service" database on the shared local Postgres container.
TODOS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todos_service"
