PORT=3000

# Internal service URL. Never exposed to the browser.
TODOS_URL="http://localhost:3001"

# Comma-separated browser origins (SPAs) allowed to call the gateway (CORS + CSRF check).
WEB_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- @acme/auth (embedded) ---

# Points at the "auth_service" database on the shared local Postgres container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the browser uses. This is the gateway.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated browser origins (SPAs) allowed to call auth.
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:5174"
