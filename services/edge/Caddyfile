# Spike only: load balancer for N api replicas.
# `dynamic a` asks Docker DNS for all A records of the `api` service. `refresh` picks up scale changes.
# Syntax: https://caddyserver.com/docs/caddyfile/directives/reverse_proxy (dynamic a [<name> <port>]).
{
	admin off
}

:3000 {
	reverse_proxy {
		dynamic a api 3000 {
			refresh 5s
		}
		lb_policy round_robin
		# Active health checks do not run for dynamic upstreams. Retry an other replica for this long.
		lb_try_duration 5s
	}
}
