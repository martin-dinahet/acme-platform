PORT=3001

# Points at the "auth_service" database on the shared local Postgres container.
AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_service"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the browser uses. This is the gateway, not this service.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated browser origins allowed to call auth.
TRUSTED_ORIGINS="http://localhost:5173"
