{
  "name": "acme-platform",
  "main": "index.js",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "services/*",
    "packages/*/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint && biome lint tests scripts services/frontend/serve.ts",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.root.json",
    "build": "turbo run build",
    "test": "bun test",
    "test:int": "bun scripts/test-int.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma"
  ]
}
