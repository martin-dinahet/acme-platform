# Local dev only: `bun run dev` (api, worker, frontend) + `docker compose up -d postgres`.
# One file for all processes. Docker compose sets its own values.

# One database for all modules. `bun run test:int` uses `acme_test` on the same server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acme"

# Signs auth sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Browser origins allowed to call the API (CORS, CSRF, Better Auth). Comma-separated.
WEB_ORIGINS="http://localhost:5173"

# Public URL of the API, as the browser sees it.
BETTER_AUTH_URL="http://localhost:3000"
